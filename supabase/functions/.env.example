# Edge Function secrets and server-only settings. Never prefix these with VITE_.
AI_EXPENSE_ENABLED=true
AI_RECEIPT_ENABLED=false
OPENROUTER_API_KEY=replace-with-a-preview-only-key

# Text uses the same models as receipts: Gemini answers first, and Gemma's many
# ZDR providers cover Google-only rate limits. Every request also enforces
# OpenRouter Zero Data Retention routing in application code.
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_FALLBACK_MODEL=google/gemma-4-26b-a4b-it

# Voice requires direct audio input, so it uses the fast audio-capable model.
OPENROUTER_VOICE_MODEL=google/gemini-3.1-flash-lite

# Receipt extraction uses low-cost image input plus JSON mode. Tally includes
# the contract in the prompt and rejects any response that fails local Zod validation.
OPENROUTER_RECEIPT_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_RECEIPT_FALLBACK_MODEL=google/gemma-4-26b-a4b-it
