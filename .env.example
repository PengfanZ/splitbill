# Safe to expose in a Vite client. Never put a Supabase secret/service-role key here.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# AI expense entry is preview-only and remains off unless explicitly enabled.
VITE_AI_EXPENSE_ENABLED=false

# Receipt splitting is an independent experiment. Keep it false outside the
# isolated receipt preview until the extraction quality and cost are accepted.
VITE_RECEIPT_SPLIT_ENABLED=false
